# PathPilot root .gitignore
# Rules specified in PathPilot Execution Handbook (Section 12)

.env
.env.*
!.env.example
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
node_modules/
build/
dist/
android/.gradle/
*.apk
*.aab

# Audio and ML Data & Artifacts (Store outside Git)
data/raw/**
data/processed/**
artifacts/models/**
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# OS & Python caches
.DS_Store
Thumbs.db
.coverage
htmlcov/
*.log
