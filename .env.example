# PathPilot Environment Configuration Example
# Audio ML Subsystem Settings

# API Service Configuration
PATHPILOT_API_HOST=0.0.0.0
PATHPILOT_API_PORT=8000
PATHPILOT_API_ENVIRONMENT=development
PATHPILOT_IS_MOCK=false

# Audio Model Configuration
AUDIO_MODEL_VERSION=v1.0.0-compact-cnn
AUDIO_MODEL_WEIGHTS_PATH=artifacts/models/pathpilot_audio_cnn_v1.pt
AUDIO_CONFIDENCE_THRESHOLD=0.60
AUDIO_SAMPLE_RATE=16000
AUDIO_DURATION_SECONDS=3.0
AUDIO_N_MELS=64
AUDIO_N_FFT=1024
AUDIO_HOP_LENGTH=512

# Privacy and Storage Boundaries (Zero Raw Audio Retention)
AUDIO_STORE_RAW_CAPTURES=false
AUDIO_REQUIRE_USER_CONFIRMATION=true
AUDIO_LOG_PERFORMANCE_METRICS=true
